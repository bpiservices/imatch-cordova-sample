<?xml version='1.0' encoding='utf-8'?>
<widget id="eu.bpiservices.imatchcordova" version="2.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>iMatch Sample</name>
    <description>Sample Apache Cordova application for the BPI iMatch.</description>
    <author email="developer@bpiservices.eu" href="https://www.bpiservices.eu/solutions/imatch/">BPI</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="https://*/*" />
    <preference name="Orientation" value="portrait" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="AndroidWindowSplashScreenBackground" value="#3F51B5" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/android/splash-icon.xml" />
        <icon density="ldpi" src="res/android/ldpi.png" />
        <icon density="mdpi" src="res/android/mdpi.png" background="res/android/mdpi-background.png" foreground="res/android/mdpi-foreground.png" />
        <icon density="hdpi" src="res/android/hdpi.png" background="res/android/hdpi-background.png" foreground="res/android/hdpi-foreground.png" />
        <icon density="xhdpi" src="res/android/xhdpi.png" background="res/android/xhdpi-background.png" foreground="res/android/xhdpi-foreground.png" />
        <icon density="xxhdpi" src="res/android/xxhdpi.png" background="res/android/xxhdpi-background.png" foreground="res/android/xxhdpi-foreground.png" />
        <icon density="xxxhdpi" src="res/android/xxxhdpi.png" background="res/android/xxxhdpi-background.png" foreground="res/android/xxxhdpi-foreground.png" />
    </platform>
    <platform name="ios">
        <preference name="deployment-target" value="14.4" />
        <icon src="res/ios/icon-1024.png" />
        <splash src="res/screen/ios/Default@2x~universal~anyany.png" />
    </platform>
</widget>
